# Synthetic local-only connection settings. Never use provider credentials here.
RCI_ENV=local
RCI_SECRETS_BACKEND=devfile
RCI_DATABASE_URL=postgresql+psycopg://rci_local:synthetic-local-only@127.0.0.1:5432/rci_local
RCI_REDIS_URL=redis://127.0.0.1:6379/0
RCI_DEV_SECRETS_FILE=.tmp/auth-secrets.json
RCI_WEB_ORIGIN=http://127.0.0.1:5173
# Temporary local convenience only; dev/stage reject true.
RCI_LOCAL_PASSWORD_LOGIN=false
